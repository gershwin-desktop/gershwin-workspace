GNUSTEP_INSTALLATION_DOMAIN = SYSTEM

# The DSStore back-end, linked as separate objects by every tool that reads
# or writes a store.
DSSTORE_SOURCES = ../../DSStore/DSStore.m \
                  ../../DSStore/DSStoreCodecs.m \
                  ../../DSStore/DSStoreEntry.m \
                  ../../DSStore/DSBuddyAllocator.m \
                  ../../DSStore/SimpleColor.m

# DSStoreInfo mirrors view style and window bounds into the folder's
# FinderInfo through GSFileMetadata, so every tool that has DSStoreInfo in it
# needs these as well.
METADATA_SOURCES = ../../GWMetadata/GSFileMetadata.m \
                   ../../GWMetadata/GSAppleDouble.m \
                   ../../GWMetadata/GWMetaXattr.m
# Include path so in-process test sources (compiled via #include of the .m
# under test) find their headers under Workspace/FileViewer/.
ADDITIONAL_INCLUDE_DIRS += -I../../Workspace/FileViewer

# t_GWAlignLogically compiles Workspace/GWAlignLogically.m in-process and
# classifies real FSNode objects, so it needs the FSNode framework and the
# Workspace + FSNode + GWMetadata header dirs on the include path.
ADDITIONAL_INCLUDE_DIRS += -I../../Workspace -I../../FSNode -I../../GWMetadata
t_GWAlignLogically_TOOL_LIBS += -lFSNode -lgnustep-gui

# DSStoreInfo resolves a background picture's alias record through
# GWFolderViewOptions and FSNAlias, which live in the built FSNode framework;
# the old DT_RPATH tag makes the loader prefer it over the installed one.
ALIAS_SOURCES = ../../Workspace/FileViewer/GWFolderViewOptions.m
ALIAS_LIBS = -lFSNode
ADDITIONAL_LDFLAGS += -Wl,--disable-new-dtags \
                      -Wl,-rpath,$(CURDIR)/../../FSNode/FSNode.framework/Versions/Current \
                      -L$(CURDIR)/../../FSNode/FSNode.framework/Versions/Current

# t_DSStoreInfo compiles DSStoreInfo.m in-process; its DSStore back-end lives
# under DSStore/ and is linked as separate objects (avoids in-TU symbol
# clashes).  DSStoreInfo now also reads/writes the folder's FinderInfo via
# GSFileMetadata (view style / window geometry fallback), so link those
# sources too.  DSStoreInfo references NSColor, so link gnustep-gui too.
ADDITIONAL_INCLUDE_DIRS += -I../../DSStore -I../../GWMetadata
t_DSStoreInfo_OBJC_FILES += $(DSSTORE_SOURCES) $(METADATA_SOURCES) $(ALIAS_SOURCES) \
                            ../../Workspace/FileViewer/GWVolumeID.m
t_DSStoreInfo_TOOL_LIBS += -lgnustep-gui $(ALIAS_LIBS)

# t_GWViewSettingsManager compiles the facade in-process; its collaborators
# (DSStoreInfo, volume cache/id, DSStore back-end) are linked as separate
# objects.  DSStoreInfo references NSColor -> gnustep-gui.
t_GWViewSettingsManager_OBJC_FILES += ../../Workspace/FileViewer/DSStoreInfo.m \
                            ../../Workspace/FileViewer/GWVolumeCache.m \
                            ../../Workspace/FileViewer/GWVolumeID.m \
                            $(DSSTORE_SOURCES) $(METADATA_SOURCES) $(ALIAS_SOURCES)
t_GWViewSettingsManager_TOOL_LIBS += -lgnustep-gui $(ALIAS_LIBS)

# t_GWViewSettingsRouting includes the facade the same way.
t_GWViewSettingsRouting_OBJC_FILES += ../../Workspace/FileViewer/DSStoreInfo.m \
                            ../../Workspace/FileViewer/GWVolumeCache.m \
                            ../../Workspace/FileViewer/GWVolumeID.m \
                            $(DSSTORE_SOURCES) $(METADATA_SOURCES) $(ALIAS_SOURCES)
t_GWViewSettingsRouting_TOOL_LIBS += -lgnustep-gui $(ALIAS_LIBS)

# t_DSStorePreserve links the DSStore back-end as separate objects so it can
# seed files with unknown/partial records and verify they survive a write
# cycle.
t_DSStorePreserve_OBJC_FILES += $(DSSTORE_SOURCES) $(METADATA_SOURCES) $(ALIAS_SOURCES) \
                            ../../Workspace/FileViewer/GWVolumeID.m
t_DSStorePreserve_TOOL_LIBS += -lgnustep-gui $(ALIAS_LIBS)

# t_DSStoreWriter exercises the writer end-to-end (build a file, read it back
# with ds_store on the Mac oracle).  Links the DSStore back-end as objects.
t_DSStoreWriter_OBJC_FILES += $(DSSTORE_SOURCES)
t_DSStoreWriter_TOOL_LIBS += -lgnustep-gui

# t_DSStoreInterop loads real Mac .DS_Store fixtures (Iloc only) and asserts
# Gershwin parses them exactly, without inventing view/window records.  Links
# the DSStore back-end as objects.
t_DSStoreInterop_OBJC_FILES += $(DSSTORE_SOURCES)
t_DSStoreInterop_TOOL_LIBS += -lgnustep-gui

# t_DSStoreVTypes locks in multi-record-type writers: folder self-entry (vstl,
# icvo, bwsp) plus child Iloc, round-tripped.  Links the DSStore back-end.
t_DSStoreVTypes_OBJC_FILES += $(DSSTORE_SOURCES)
t_DSStoreVTypes_TOOL_LIBS += -lgnustep-gui

# t_DSStoreRecordTypes exercises EVERY record type the writer supports
# (folder self-entry settings + per-file records), round-tripped.  Links the
# DSStore back-end.
t_DSStoreRecordTypes_OBJC_FILES += $(DSSTORE_SOURCES)
t_DSStoreRecordTypes_TOOL_LIBS += -lgnustep-gui

# t_DSStoreViewWindowInterop: every view style (vstl) round-trips, plus the
# browser window frame (bwsp) and legacy window geometry (fwi0); and a real
# Mac 10.6 .DS_Store is read without inventing view/window records.  Links the
# DSStore back-end.
t_DSStoreViewWindowInterop_OBJC_FILES += $(DSSTORE_SOURCES)
t_DSStoreViewWindowInterop_TOOL_LIBS += -lgnustep-gui

# t_GWViewerToolbarModel compares the item sets with AppKit's own toolbar
# item identifiers (flexible space, separator), which live in gnustep-gui.
t_GWViewerToolbarModel_TOOL_LIBS += -lgnustep-gui

# t_GWViewerIconsViewResize includes GWViewerIconsView.m and drives it in a
# real scroll view, on top of the framework just built.
t_GWViewerIconsViewResize_INCLUDE_DIRS += -I../../Workspace/Desktop
t_GWViewerIconsViewResize_TOOL_LIBS += -lFSNode -lgnustep-gui
