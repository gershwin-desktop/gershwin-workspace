GNUSTEP_INSTALLATION_DOMAIN = SYSTEM
# In-process test sources (#include of the .m under test) live in Workspace/.
ADDITIONAL_INCLUDE_DIRS += -I../../Workspace
# GWApplicationLauncher.m builds its error alert from AppKit classes.
t_GWApplicationLauncher_TOOL_LIBS += -lgnustep-gui
# X11AppSupport.m talks to GNUstepGUI/GSDisplayServer and to Xlib directly.
t_GWX11AppSupport_TOOL_LIBS += -lgnustep-gui -lX11

# GWArchiveOperation.m builds a progress panel from AppKit classes (never
# actually shown - the test drives runCompress directly, not -run) and
# imports GWMetaArchive.h, whose implementation is linked as a separate
# object per the GSMetadata subproject's own library/deps.
ADDITIONAL_INCLUDE_DIRS += -I../../GWMetadata
t_GWArchiveOperationCancel_OBJC_FILES += ../../GWMetadata/GWMetaArchive.m
t_GWArchiveOperationCancel_TOOL_LIBS += -lgnustep-gui -lGSMetadata -larchive

# GWThumbnailer.m imports AppKit/AppKit.h (NSBundle/NSImage-adjacent code
# paths) and dispatch/dispatch.h (header only - no dispatch_* call remains).
ADDITIONAL_INCLUDE_DIRS += -I../../Workspace/Thumbnailer
t_GWThumbnailerConcurrency_TOOL_LIBS += -lgnustep-gui
# X11AppSupport.m needs AppKit and Xlib even when only its thread is exercised.
t_GWX11ScanThread_TOOL_LIBS += -lgnustep-gui -lX11

# t_AppImageProbeCache and t_AppImageDirIconCycle #include
# AppImageIconProvider.m in-process (the unit under test). Its own
# FSNodeRep/FSNIcon categories reference those two classes by name, so
# linking the built FSNode framework (not a fresh in-tree copy) resolves
# them exactly like Workspace itself does; libsquashfs is the library the
# unit was built against.
ADDITIONAL_INCLUDE_DIRS += -I../../FSNode
ADDITIONAL_LDFLAGS += -Wl,--disable-new-dtags \
                      -Wl,-rpath,$(CURDIR)/../../FSNode/FSNode.framework/Versions/Current
t_AppImageProbeCache_TOOL_LIBS += -L../../FSNode/FSNode.framework/Versions/Current \
                                  -lFSNode -lgnustep-gui
t_AppImageDirIconCycle_TOOL_LIBS += -L../../FSNode/FSNode.framework/Versions/Current \
                                    -lFSNode -lgnustep-gui
# Workspace is built without AppImage support when libsquashfs is missing
# (configure.ac); the two tests then say so instead of failing to compile.
# They follow configure's own decision (HAVE_SQUASHFS in Workspace/config.h)
# rather than probing again: on FreeBSD a second probe found the library
# that configure had rejected and linked a tool Workspace itself never uses.
ifneq ($(shell grep -s '^\#define HAVE_SQUASHFS 1' ../../Workspace/config.h),)
GW_SQUASHFS_PC := $(firstword $(foreach p,libsquashfs squashfs,\
                    $(shell pkg-config --exists $(p) 2>/dev/null && echo $(p))))
GW_SQUASHFS_FLAGS := $(if $(GW_SQUASHFS_PC),$(shell pkg-config --cflags $(GW_SQUASHFS_PC)))
GW_SQUASHFS_LIBS := $(if $(GW_SQUASHFS_PC),$(shell pkg-config --libs $(GW_SQUASHFS_PC)),-lsquashfs)
else
GW_SQUASHFS_FLAGS := -DGW_NO_SQUASHFS
GW_SQUASHFS_LIBS :=
endif
t_AppImageProbeCache_OBJCFLAGS += $(GW_SQUASHFS_FLAGS)
t_AppImageDirIconCycle_OBJCFLAGS += $(GW_SQUASHFS_FLAGS)
t_AppImageProbeCache_TOOL_LIBS += $(GW_SQUASHFS_LIBS)
t_AppImageDirIconCycle_TOOL_LIBS += $(GW_SQUASHFS_LIBS)

# VMPathIsActiveMountPoint is a `static inline` predicate declared directly
# in VolumeManager.h (not VolumeManager.m), specifically so this test can
# exercise VolumeManager's real mount-detection logic without dragging in
# VolumeManager.m's AppKit/Workspace/FSNode/AVFS dependencies. It calls
# +[GWVolumeID mountedFilesystems], linked here as a separate object.
t_VolumeManagerMountDetection_OBJC_FILES += ../../Workspace/FileViewer/GWVolumeID.m

# t_GWLookInsideInfo #includes GWLookInsidePreviewView.m (the unit under
# test, an NSView subclass used without drawing) and links the preview kind
# decision, the geometry and the column provider as separate objects; FSNode
# gives the item's facts and the icons, linked from the build tree like the
# AppImage tests above.
ADDITIONAL_INCLUDE_DIRS += -I../../Workspace/LookInside
t_GWLookInsideInfo_OBJC_FILES += ../../Workspace/LookInside/GWLookInsidePreviewKind.m \
                                 ../../Workspace/LookInside/GWLookInsideGeometry.m \
                                 ../../Workspace/LookInside/GWLookInsideColumnPreviewProvider.m
t_GWLookInsideInfo_TOOL_LIBS += -L../../FSNode/FSNode.framework/Versions/Current \
                                -lFSNode -lgnustep-gui

# t_GWStationery includes GWStationery.m; the copier and the Finder metadata
# library it uses are linked as separate objects, as in Tests/Preserve.
ADDITIONAL_INCLUDE_DIRS += -I../../Operation -I../../DSStore
t_GWStationery_OBJC_FILES += ../../Operation/GWMetadataCopier.m \
                             ../../GWMetadata/GSAppleDouble.m \
                             ../../GWMetadata/GWMetaXattr.m \
                             ../../GWMetadata/GSFileMetadata.m \
                             ../../DSStore/DSStore.m ../../DSStore/DSStoreCodecs.m \
                             ../../DSStore/DSStoreEntry.m ../../DSStore/DSBuddyAllocator.m \
                             ../../DSStore/SimpleColor.m
t_GWStationery_TOOL_LIBS += -lgnustep-gui
