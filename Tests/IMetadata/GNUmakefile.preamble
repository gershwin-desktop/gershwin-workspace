GNUSTEP_INSTALLATION_DOMAIN = SYSTEM
ADDITIONAL_OBJCFLAGS += -Wno-deprecated
ADDITIONAL_INCLUDE_DIRS += -I../../GWMetadata -I../../FSNode -I../../Workspace

# GSFileMetadata references NSImage/NSColor, so both tools link gnustep-gui.
# The sources are linked as separate objects: t_IMetaWrite includes none of
# them so the test sees only the public interface.
t_IMetaWrite_OBJC_FILES += ../../GWMetadata/GSFileMetadata.m \
                           ../../GWMetadata/GSAppleDouble.m \
                           ../../GWMetadata/GWMetaXattr.m
t_IMetaWrite_TOOL_LIBS += -lgnustep-gui

t_IMetaProvider_OBJC_FILES += ../../Workspace/GWMetadataProvider.m \
                              ../../GWMetadata/GSFileMetadata.m \
                              ../../GWMetadata/GSAppleDouble.m \
                              ../../GWMetadata/GWMetaXattr.m
t_IMetaProvider_TOOL_LIBS += -lgnustep-gui

t_IMetaResources_OBJC_FILES += ../../GWMetadata/GSFileMetadata.m \
                               ../../GWMetadata/GSAppleDouble.m \
                               ../../GWMetadata/GWMetaXattr.m
t_IMetaResources_TOOL_LIBS += -lgnustep-gui
