GNUSTEP_INSTALLATION_DOMAIN = SYSTEM
ADDITIONAL_INCLUDE_DIRS += -I../../FSNode -I../../FSNode/ExtendedInfo

# clang 19 / binutils 2.44 regression: the ABI 2.2 .objc_init section always
# references the __objc_constant_string section bounds, but the linker only
# synthesizes those __start_/__stop_ symbols when the section exists.
ADDITIONAL_LDFLAGS += -Wl,--defsym=__start___objc_constant_string=0 \
                      -Wl,--defsym=__stop___objc_constant_string=0

# The tools drive real FSNIconsView/FSNIcon objects, so they link the built
# framework.  Without the old DT_RPATH tag the loader would pick the
# installed framework from LD_LIBRARY_PATH and report on /System instead of
# on what was just built.
ADDITIONAL_LDFLAGS += -Wl,--disable-new-dtags \
                      -Wl,-rpath,$(CURDIR)/../../FSNode/FSNode.framework/Versions/Current

t_FSNIconItemInfo_TOOL_LIBS += -L../../FSNode/FSNode.framework/Versions/Current \
                               -lFSNode -lgnustep-gui
t_FSNIconsViewOptions_TOOL_LIBS += -L../../FSNode/FSNode.framework/Versions/Current \
                                   -lFSNode -lgnustep-gui
t_FSNIconsViewURLDrop_TOOL_LIBS += -L../../FSNode/FSNode.framework/Versions/Current \
                                   -lFSNode -lgnustep-gui
