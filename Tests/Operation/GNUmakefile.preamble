GNUSTEP_INSTALLATION_DOMAIN = SYSTEM

ADDITIONAL_OBJCFLAGS += -Wno-deprecated
ADDITIONAL_INCLUDE_DIRS += -I../../Operation -I../../FSNode -I../../GWMetadata -I../../DSStore

# FileOpInfo.m pulls in most of AppKit (nib loading, IBOutlets, NSWorkspace
# operation constants) plus FSNAlias (from the FSNode framework, used by
# FileOpExecutor's alias path) and Functions.m (relativePathFittingInField,
# referenced - even though not called on this test's path - by symbol, so it
# must link), and the undo history FileOpInfo reports finished operations
# to.  Link the built FSNode framework by path so the tool exercises what
# was just built, not the installed copy.
t_FileOpInfoRemoveProcessedFiles_OBJC_FILES += ../../Operation/FileOpInfo.m \
                                               ../../Operation/Functions.m \
                                               ../../Operation/GWMetadataCopier.m \
                                               ../../Operation/GWFileUndoStack.m \
                                               ../../Operation/GWFileUndoRecord.m \
                                               ../../GWMetadata/GSAppleDouble.m \
                                               ../../GWMetadata/GWMetaXattr.m \
                                               ../../GWMetadata/GSFileMetadata.m \
                                               ../../DSStore/DSStore.m ../../DSStore/DSStoreCodecs.m \
                                               ../../DSStore/DSStoreEntry.m ../../DSStore/DSBuddyAllocator.m \
                                               ../../DSStore/SimpleColor.m
t_FileOpInfoRemoveProcessedFiles_TOOL_LIBS += -L../../FSNode/FSNode.framework/Versions/Current \
                                              -lFSNode -lgnustep-gui -ldispatch
ADDITIONAL_LDFLAGS += -Wl,--disable-new-dtags \
                      -Wl,-rpath,$(CURDIR)/../../FSNode/FSNode.framework/Versions/Current
