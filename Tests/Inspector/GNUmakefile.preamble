GNUSTEP_INSTALLATION_DOMAIN = SYSTEM
# The model is compiled in-process; GSFileMetadata and its helpers are linked
# as separate objects.  They reference NSImage/NSColor, hence gnustep-gui.
ADDITIONAL_INCLUDE_DIRS += -I../../Inspector -I../../GWMetadata
t_FinderInfoModel_OBJC_FILES += ../../GWMetadata/GSFileMetadata.m \
                                ../../GWMetadata/GSAppleDouble.m \
                                ../../GWMetadata/GWMetaXattr.m
t_FinderInfoModel_TOOL_LIBS += -lgnustep-gui

# The model reaches the immutable flag through FinderInfoLocker, which pulls
# in the sudo helper of PackageManager for the Linux privileged path.
t_FinderInfoModel_OBJC_FILES += ../../Inspector/FinderInfoLocker.m
t_FinderInfoModel_TOOL_LIBS += -lPackageManager
t_FinderInfoLocker_OBJC_FILES += ../../Inspector/FinderInfoLocker.m
t_FinderInfoLocker_TOOL_LIBS += -lPackageManager
