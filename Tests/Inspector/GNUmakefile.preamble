GNUSTEP_INSTALLATION_DOMAIN = SYSTEM
# The model is compiled in-process; GSFileMetadata and its helpers are linked
# as separate objects.  They reference NSImage/NSColor, hence gnustep-gui.
ADDITIONAL_INCLUDE_DIRS += -I../../Inspector -I../../GWMetadata
t_FinderInfoModel_OBJC_FILES += ../../GWMetadata/GSFileMetadata.m \
                                ../../GWMetadata/GSAppleDouble.m \
                                ../../GWMetadata/GWMetaXattr.m
t_FinderInfoModel_TOOL_LIBS += -lgnustep-gui

# The model reaches the immutable flag through FinderInfoLocker.
t_FinderInfoModel_OBJC_FILES += ../../Inspector/FinderInfoLocker.m
t_FinderInfoLocker_OBJC_FILES += ../../Inspector/FinderInfoLocker.m

# MI-INS-15: the comment is also written into the parent's .DS_Store.
ADDITIONAL_INCLUDE_DIRS += -I../../DSStore
t_FinderInfoModel_OBJC_FILES += ../../DSStore/DSStore.m ../../DSStore/DSStoreCodecs.m \
                                ../../DSStore/DSStoreEntry.m ../../DSStore/DSBuddyAllocator.m \
                                ../../DSStore/SimpleColor.m

# SummaryInfoModel reads label and lock state through FinderInfoModel.
t_SummaryInfoModel_OBJC_FILES += ../../Inspector/FinderInfoModel.m \
                                 ../../Inspector/FinderInfoLocker.m \
                                 ../../GWMetadata/GSFileMetadata.m \
                                 ../../GWMetadata/GSAppleDouble.m \
                                 ../../GWMetadata/GWMetaXattr.m \
                                 ../../DSStore/DSStore.m ../../DSStore/DSStoreCodecs.m \
                                 ../../DSStore/DSStoreEntry.m ../../DSStore/DSBuddyAllocator.m \
                                 ../../DSStore/SimpleColor.m
t_SummaryInfoModel_TOOL_LIBS += -lgnustep-gui
