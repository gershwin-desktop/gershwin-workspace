GNUSTEP_INSTALLATION_DOMAIN = SYSTEM
ADDITIONAL_OBJCFLAGS += -Wno-deprecated
ADDITIONAL_INCLUDE_DIRS += -I../../GWMetadata

# GWMetaArchive and the metadata units it uses, linked as objects.
# GSFileMetadata references NSImage/NSColor, hence gnustep-gui.
t_GWMetaArchive_OBJC_FILES += ../../GWMetadata/GWMetaArchive.m \
                              ../../GWMetadata/GSFileMetadata.m \
                              ../../GWMetadata/GSAppleDouble.m \
                              ../../GWMetadata/GWMetaXattr.m
t_GWMetaArchive_TOOL_LIBS += -lgnustep-gui -larchive
